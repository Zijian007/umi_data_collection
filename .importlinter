[importlinter]
root_package = umi
# 类型标注专用导入不参与运行期分层。
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = umi 分层：上层可依赖下层，下层不得依赖上层
type = layers
layers =
    umi.apps
    umi.dataset
    umi.workflows
    umi.estimation
    umi.store
    umi.perception
    umi.devices
    umi.config
    umi.infra
    umi.core

[importlinter:contract:workflows]
name = 流程之间：标定 > 场景 > 内部逐段引擎
type = layers
layers =
    umi.workflows.calibration
    umi.workflows.scene
    umi.workflows.segment
