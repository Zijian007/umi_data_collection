#!/usr/bin/env bash
# umi-scene：从 batch.yaml 和原片建图、抽取轨迹、验收与导出。
#   ./umi-scene run scenes/test_shelf/20261109_002
#   ./umi-scene run scenes/test_shelf/20261109_002 --dry-run
#   ./umi-scene run scenes/test_shelf/20261109_002 --show-config
#   ./umi-scene run --help
# 套件和标定来源写法见 kits/README.md；操作说明见 docs/场景处理.md。
# 命令行 / YAML / 资产分工及 --config 覆盖规则见 config/README.md。
# 完整参数见 docs/命令行参数.md；参数由 software/scene/cli.py 解析。
# UMI_DEPS 覆盖依赖目录；UMI_PY 覆盖基础解释器。
set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
DEPENDENCY_ROOT=${UMI_DEPS:-$PROJECT_ROOT/.deps}
if [ ! -f "$DEPENDENCY_ROOT/env.sh" ]; then
  echo "还没安装：先运行 bash $PROJECT_ROOT/install.sh" >&2
  exit 2
fi

source "$DEPENDENCY_ROOT/env.sh"
export UMI_PY=${UMI_PY:-$DEPENDENCY_ROOT/env/bin/python}
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$UMI_PY" -m software.scene "$@"
