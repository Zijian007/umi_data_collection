#!/usr/bin/env bash
# umi-view：视频、轨迹和标签间距的同步查看器。
#   ./umi-view                         # 默认扫描项目 scenes/
#   ./umi-view scenes/test_shelf --port 9092
#   ./umi-view --help
#   ./umi-view --show-config
# 启动选项只在命令行设置，不读取算法 YAML；统一说明见 config/README.md。
# 详细操作见 docs/结果查看与验收.md；参数由 software/viewer/server.py 解析。
# UMI_VIEW_PYTHON 覆盖解释器；UMI_DEPS 覆盖依赖目录。
set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
DEPENDENCY_ROOT=${UMI_DEPS:-$PROJECT_ROOT/.deps}
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

PYTHON_EXECUTABLE=${UMI_VIEW_PYTHON:-$DEPENDENCY_ROOT/env/bin/python}
if [ -z "${UMI_VIEW_PYTHON:-}" ] && [ ! -x "$PYTHON_EXECUTABLE" ]; then
  PYTHON_EXECUTABLE=python3
fi
exec "$PYTHON_EXECUTABLE" -m software.viewer "$@"
